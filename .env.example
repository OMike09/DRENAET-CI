# Ce fichier contient UNIQUEMENT des noms. Ne commitez jamais les valeurs réelles.
# DATABASE_URL est à renseigner dans l'environnement de Render déjà prévu, sans publier sa valeur.
DATABASE_URL=
BOOTSTRAP_LOGIN=
BOOTSTRAP_PASSWORD=
PORT=8000
# Utiliser 'require' lorsque PostgreSQL impose TLS, avec certificat vérifié.
PGSSLMODE=
