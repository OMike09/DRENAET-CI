# Ce fichier contient UNIQUEMENT des noms. Ne commitez jamais les valeurs réelles.
# DATABASE_URL est à renseigner dans l'environnement de Render déjà prévu, sans publier sa valeur.
DATABASE_URL=
BOOTSTRAP_LOGIN=
BOOTSTRAP_PASSWORD=
PORT=8000
# Utiliser 'require' lorsque PostgreSQL impose TLS, avec certificat vérifié.
PGSSLMODE=
# Push web facultatif : ajouter les TROIS variables exclusivement dans l'environnement privé du service.
# Ne jamais commiter la clé privée ; ne pas réutiliser un ancien secret exposé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Courrier sortant externe facultatif : configurer UNIQUEMENT sur Render (TLS SMTPS obligatoire).
# Sans ces deux valeurs, un envoi reste en file et aucun courriel n'est présenté comme livré.
COURIER_SMTP_URL=
COURIER_MAIL_FROM=
